# ReGrip 백엔드 환경변수 예시 (Windows PowerShell 기준)
# 이 파일을 복사해 backend/.env 로 만들어 사용한다. .env 는 커밋 금지(루트 .gitignore).

# ─── 데이터베이스 ───────────────────────────────────────────────
# 개발/기본: SQLite (파일). 운영: PostgreSQL DSN 을 넣으면 그대로 전환된다.
#   개발  : sqlite:///./regrip_dev.db
#   운영  : postgresql+psycopg://user:password@host:5432/regrip
DATABASE_URL=sqlite:///./regrip_dev.db

# ─── 배포 환경 ─────────────────────────────────────────────────
# dev | test | prod  (prod 일 때만 Refresh 쿠키에 Secure 플래그가 붙는다)
ENV=dev

# ─── JWT ───────────────────────────────────────────────────────
# 운영에서는 반드시 길고 무작위한 값으로 교체한다 (예: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ─── 전화번호 애플리케이션 레벨 암호화(AES-GCM) ──────────────────
# 32바이트 키를 base64(urlsafe) 로 인코딩한 값. 비우면 개발용 고정 키를 사용(운영 금지).
#   생성: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PHONE_ENC_KEY=

# ─── CORS (로컬 프론트 오리진 화이트리스트, 콤마 구분) ───────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ─── 도메인 규칙 ───────────────────────────────────────────────
MAX_DAILY_SESSIONS=20
STARTED_AT_SKEW_SEC=300

# ─── 정적 파일(아바타) 저장 경로 ────────────────────────────────
STORAGE_DIR=./storage
