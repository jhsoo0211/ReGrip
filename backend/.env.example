# ReGrip 백엔드 환경변수 예시 (Windows PowerShell 기준)
# 이 파일을 복사해 backend/.env 로 만들어 사용한다. .env 는 커밋 금지(루트 .gitignore).

# ─── 데이터베이스 ───────────────────────────────────────────────
# 개발/기본: SQLite (파일). 운영: PostgreSQL DSN 을 넣으면 그대로 전환된다.
#   개발  : sqlite:///./regrip_dev.db
#   운영  : postgresql+psycopg://user:password@host:5432/regrip
DATABASE_URL=sqlite:///./regrip_dev.db

# ─── 배포 환경 ─────────────────────────────────────────────────
# dev | test | prod  (prod 일 때만 Refresh 쿠키에 Secure 플래그가 붙는다)
# ENV=prod 로 기동하면 src/main.py 가 아래 [운영 필수] 항목을 검사하고,
# 하나라도 위반이면 RuntimeError 로 기동을 중단한다(위반 항목은 한 번에 전부 보고).
ENV=dev

# ─── JWT ───────────────────────────────────────────────────────
# [운영 필수] ENV=prod 에서는 기본값(dev-insecure-change-me) 금지 + 32자 이상이어야 한다.
#   공개된 기본값을 그대로 두면 누구나 액세스 토큰을 위조할 수 있다.
#   생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ─── 전화번호 애플리케이션 레벨 암호화(AES-GCM) ──────────────────
# 32바이트 키를 base64(urlsafe) 로 인코딩한 값. 비우면 JWT_SECRET 에서 유도한 개발용 고정 키를 쓴다.
# [운영 필수] ENV=prod 에서는 비워 둘 수 없다(비면 JWT_SECRET 유출 시 전화번호까지 복호화됨).
#   생성: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PHONE_ENC_KEY=

# ─── CORS (로컬 프론트 오리진 화이트리스트, 콤마 구분) ───────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ─── 도메인 규칙 ───────────────────────────────────────────────
MAX_DAILY_SESSIONS=20
STARTED_AT_SKEW_SEC=300
# 백데이트 허용 하한(시간). 오프라인 큐 재전송 폭이며, 이보다 오래된 startedAt 은 422 로 거부한다.
BACKDATE_LIMIT_HOURS=72
# 사용자 기본 타임존(IANA). user_settings.timezone 미설정/무효 시 폴백.
DEFAULT_TIMEZONE=Asia/Seoul
# 아바타 업로드 크기 상한(바이트). 기본 2 MiB.
AVATAR_MAX_BYTES=2097152

# ─── 정적 파일(아바타) 저장 경로 ────────────────────────────────
STORAGE_DIR=./storage

# ─── 로깅 ──────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL (기본 INFO)
# 처리되지 않은 500 예외는 스택트레이스와 함께 이 설정으로 기록된다.
LOG_LEVEL=INFO
